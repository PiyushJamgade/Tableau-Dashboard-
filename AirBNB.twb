      <aliases enabled='yes' />
      <column caption='Pricing Categories' datatype='string' name='[Calculation_4454341555375337473]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price]&gt;= 150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category ' datatype='string' name='[Calculation_4454341555376775170]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;=100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Availability Status' datatype='string' name='[Calculation_4454341555377389571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Status&quot;&#13;&#10;ELSE &quot;New Host&quot; END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_4454341555381182468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Price Parameter] THEN &quot;Above Limit&quot; &#13;&#10;ELSE &quot;Below Limit&quot; END' />
      </column>
